SECRET_KEY=change-me-to-a-random-string

# ── SMTP (email notifications) ───────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=loans@ibs.co.ug

# ── Approver emails ───────────────────────────────────────────────────────────
TIER1_EMAIL=loan.officer1@ibs.co.ug
TIER2_EMAIL=loan.officer2@ibs.co.ug
TIER3_EMAIL=loan.officer3@ibs.co.ug

# ── Approver WhatsApp numbers (international format, e.g. +256700000000) ─────
TIER1_WHATSAPP=+256700000001
TIER2_WHATSAPP=+256700000002
TIER3_WHATSAPP=+256700000003

# ── Twilio (WhatsApp notifications) ──────────────────────────────────────────
# Sign up at https://www.twilio.com — use the sandbox for testing
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Sandbox number (testing): +14155238886  |  Production: your approved Twilio number
TWILIO_WHATSAPP_FROM=+14155238886

# ── Loan settings ─────────────────────────────────────────────────────────────
DEFAULT_PENALTY_RATE=5.0
