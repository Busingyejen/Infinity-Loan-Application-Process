SECRET_KEY=change-me-to-a-random-string

# SMTP settings (example: Gmail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Approval chain — one email per tier
TIER1_EMAIL=tier1.approver@company.com
TIER2_EMAIL=tier2.approver@company.com
TIER3_EMAIL=tier3.approver@company.com

# Where applicant notifications come from
MAIL_DEFAULT_SENDER=loans@company.com
